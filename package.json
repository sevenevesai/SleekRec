{
  "name": "sleek-recorder",
  "description": "A sleek, modern window recorder",
  "author": "SleekRec",
  "license": "MIT",
  "version": "1.2.0",
  "homepage": "https://github.com/sevenevesai/SleekRec",
  "main": "dist-electron/main.js",
  "scripts": {
    "native": "node scripts/build-native.cjs",
    "test": "node --test scripts/test-recording.cjs",
    "test:recording": "npm run native && tsc --noEmit && vite build && node scripts/smoke-recording.cjs",
    "predev": "npm run native",
    "prebuild": "npm run native",
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:win": "npm run native && tsc && vite build && electron-builder --win",
    "build:mac": "tsc && vite build && electron-builder --mac",
    "build:linux": "tsc && vite build && electron-builder --linux",
    "icons": "node scripts/generate-icons.js",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.sleek.recorder",
    "productName": "SleekRec",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist_app",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "electronLanguages": [
      "en-US",
      "en"
    ],
    "win": {
      "files": [
        "dist/**/*",
        "dist-electron/**/*",
        "!node_modules/ffmpeg-static/**"
      ],
      "extraResources": [
        {
          "from": "native/bin/windows-displays.exe",
          "to": "windows-displays.exe"
        },
        {
          "from": "vendor/ffmpeg/win32-x64/ffmpeg.exe",
          "to": "ffmpeg.exe"
        },
        {
          "from": "vendor/ffmpeg/win32-x64/LICENSE.txt",
          "to": "ffmpeg-LICENSE.txt"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "msi": {
      "oneClick": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon-512.png",
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build",
      "category": "AudioVideo",
      "maintainer": "SleekRec"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SleekRec",
      "uninstallDisplayName": "SleekRec"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "sevenevesai",
      "repo": "SleekRec"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^44.9.3",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.2"
  }
}
